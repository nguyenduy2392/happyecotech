APP_NAME="Happy Ecotech"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://happyecotech.com
APP_TIMEZONE=UTC

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---- Microsoft SQL Server đã được thay bằng PostgreSQL theo quyết định của chủ dự án ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=happyecotech
DB_USERNAME=happyecotech
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Media lưu trên filesystem (storage/app/public) qua Storage abstraction -> đổi S3 dễ dàng.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP đọc từ đây, KHÔNG commit secret thật.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@happyecotech.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email nhận thông báo lead (tuỳ chọn). Trống thì bỏ qua gửi mail, lead vẫn được lưu.
CONTACT_NOTIFY_TO=

# Seed SuperAdmin đầu tiên (đổi mật khẩu ngay sau lần đăng nhập đầu).
HE_ADMIN_NAME="Super Admin"
HE_ADMIN_EMAIL=admin@happyecotech.com
HE_ADMIN_PASSWORD=

# S3-compatible storage (tuỳ chọn, để trống nếu dùng local disk).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
